{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TomboGCoder",
  "version": "0.2.0",
  "identifier": "com.tombogcoder.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TomboGCoder — FANUC 3軸 NC Viewer",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "shadow": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxOTMxNzQyMzNCODU2RjQKUldUMFZyZ3pRaGVUY1pGV0w5cmFnalkrc21YNG5id0tCK2ZDNklFL1lIZk1WcFRJK2o5VzY3VGcK",
      "endpoints": [
        "https://github.com/heli0us/TomboGCoder/releases/latest/download/latest.json"
      ]
    }
  }
}
